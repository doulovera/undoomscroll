# Create an internal Notion integration, share both databases with it, and paste its token here.
NOTION_TOKEN=secret_replace_me

# These defaults point at the two data sources under your Social Media page.
NOTION_ACCOUNTS_DATA_SOURCE_ID=3d186038-1942-8049-84cc-000bf62ac44c
NOTION_POSTS_DATA_SOURCE_ID=3d186038-1942-80e7-98ff-000b39e28848

# One accepted sync request per five minutes. The value is milliseconds.
RATE_LIMIT_MS=300000

PORT=3000
FXTWITTER_BASE_URL=https://api.fxtwitter.com
FXTWITTER_PAGE_SIZE=20
FXTWITTER_MAX_PAGES=10
NOTION_VERSION=2026-03-11
